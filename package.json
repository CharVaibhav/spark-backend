  "description": "Spark API — Express + Redis Pub/Sub + Mastra AI Agents",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers.ts",
