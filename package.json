    "@mastra/mcp": "^1.3.1",
    "@mastra/memory": "^1.8.3",
    "@mastra/observability": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crawlee": "^3.16.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
